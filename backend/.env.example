# JWT
JWT_SECRET=sua_chave_secreta_aqui
JWT_EXPIRES_IN=7d

# Servidor
PORT=3001

# PostgreSQL (Railway fornece automaticamente)
DATABASE_URL=postgresql://usuario:senha@host:5432/database

# Ambiente
NODE_ENV=development

# Resend (e-mail transacional)
RESEND_API_KEY=re_xxxxxxxxxx

# URL do frontend (para links de redefinição de senha)
FRONTEND_URL=https://dashboardconsorcio.up.railway.app

# API Key para acesso externo ao endpoint de acompanhamento
ACOMPANHAMENTO_API_KEY=
